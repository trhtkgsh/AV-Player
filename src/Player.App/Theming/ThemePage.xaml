<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Player.App.Theming.ThemePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Player.App.Localization"
             xmlns:local="clr-namespace:Player.App.Theming"
             x:DataType="local:ThemeViewModel"
             Title="{loc:T Theme.Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <Label Text="{loc:T Theme.Themes}" Style="{StaticResource LabelSection}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Themes}" Spacing="2">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:ThemeChoice">
                        <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="✓" FontAttributes="Bold"
                                   TextColor="{DynamicResource ColorOnSurface}" VerticalOptions="Center"
                                   IsVisible="{Binding IsSelected}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectThemeCommand, Source={RelativeSource AncestorType={x:Type local:ThemeViewModel}}, x:DataType=local:ThemeViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="{loc:T Theme.Accent}" Style="{StaticResource LabelSection}" />

            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start"
                        BindableLayout.ItemsSource="{Binding Accents}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:AccentSwatch">
                        <Border WidthRequest="44" HeightRequest="44" Margin="5" StrokeShape="RoundRectangle 22"
                                BackgroundColor="{Binding Color}" Stroke="{DynamicResource ColorDivider}"
                                StrokeThickness="1" SemanticProperties.Description="{Binding Description}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ColorOnSurface}" />
                                    <Setter Property="StrokeThickness" Value="4" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectAccentCommand, Source={RelativeSource AncestorType={x:Type local:ThemeViewModel}}, x:DataType=local:ThemeViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                <Label Grid.Column="0" Text="{loc:T Theme.HudOpacity}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding HudOpacityText}" VerticalOptions="Center" />
            </Grid>
            <Slider Minimum="0" Maximum="100"
                    Value="{Binding HudOpacityPercent, Mode=TwoWay}"
                    DragCompletedCommand="{Binding ApplyHudOpacityCommand}" />

            <Label Text="{loc:T Theme.Preview}" Style="{StaticResource LabelSection}" />

            <Border HeightRequest="88" StrokeShape="RoundRectangle 8" StrokeThickness="1"
                    Stroke="{DynamicResource ColorDivider}"
                    BackgroundColor="{DynamicResource ColorOnSurfaceMuted}">
                <Grid VerticalOptions="End" Padding="16,12"
                      BackgroundColor="{DynamicResource ColorHudBackground}">
                    <Label Text="{loc:T Theme.PreviewSample}" Style="{StaticResource LabelHud}" />
                </Grid>
            </Border>

            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   TextColor="{DynamicResource ColorDanger}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

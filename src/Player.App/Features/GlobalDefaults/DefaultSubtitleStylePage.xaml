<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Player.App.Features.DefaultsSettings.DefaultSubtitleStylePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Player.App.Features.DefaultsSettings"
             xmlns:loc="clr-namespace:Player.App.Localization"
             x:DataType="local:DefaultSubtitleStyleViewModel"
             Title="{loc:T Defaults.SubtitleStyle}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <Label Text="{loc:T Defaults.Style.Note}"
                   Style="{StaticResource LabelMuted}" />

            <Label Text="{loc:T Defaults.Style.TextSize}" />
            <HorizontalStackLayout Spacing="8">
                <Label Text="{Binding FontScaleText}" VerticalOptions="Center" />
                <Button Text="{loc:T Defaults.Style.Smaller}" Style="{StaticResource ButtonQuiet}" Command="{Binding FontScaleDownCommand}" />
                <Button Text="{loc:T Defaults.Style.Larger}" Style="{StaticResource ButtonQuiet}" Command="{Binding FontScaleUpCommand}" />
            </HorizontalStackLayout>

            <Label Text="{loc:T Defaults.Style.TextColor}" />
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding TextColors}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:ColorSwatch">
                        <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 8"
                                BackgroundColor="{Binding Color}" Stroke="{DynamicResource ColorDivider}"
                                StrokeThickness="1" SemanticProperties.Description="{Binding Name}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ColorAccent}" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectTextColorCommand, Source={RelativeSource AncestorType={x:Type local:DefaultSubtitleStyleViewModel}}, x:DataType=local:DefaultSubtitleStyleViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <Label Text="{loc:T Defaults.Style.OutlineColor}" />
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding OutlineColors}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:ColorSwatch">
                        <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 8"
                                BackgroundColor="{Binding Color}" Stroke="{DynamicResource ColorDivider}"
                                StrokeThickness="1" SemanticProperties.Description="{Binding Name}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ColorAccent}" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectOutlineColorCommand, Source={RelativeSource AncestorType={x:Type local:DefaultSubtitleStyleViewModel}}, x:DataType=local:DefaultSubtitleStyleViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <Label Text="{loc:T Defaults.Style.OutlineThickness}" />
            <HorizontalStackLayout Spacing="8">
                <Label Text="{Binding OutlineThicknessText}" VerticalOptions="Center" />
                <Button Text="{loc:T Defaults.Style.Thinner}" Style="{StaticResource ButtonQuiet}" Command="{Binding OutlineThinnerCommand}" />
                <Button Text="{loc:T Defaults.Style.Thicker}" Style="{StaticResource ButtonQuiet}" Command="{Binding OutlineThickerCommand}" />
            </HorizontalStackLayout>

            <Label Text="{loc:T Defaults.Style.Background}" />
            <HorizontalStackLayout Spacing="8">
                <Label Text="{Binding BackgroundOpacityText}" VerticalOptions="Center" />
                <Button Text="{loc:T Defaults.Style.Lighter}" Style="{StaticResource ButtonQuiet}" Command="{Binding BackgroundLighterCommand}" />
                <Button Text="{loc:T Defaults.Style.Darker}" Style="{StaticResource ButtonQuiet}" Command="{Binding BackgroundDarkerCommand}" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{loc:T Defaults.Style.Bold}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding Bold, Mode=TwoWay}" />
            </Grid>

            <Label Text="{loc:T Defaults.Style.BottomMargin}" />
            <HorizontalStackLayout Spacing="8">
                <Label Text="{Binding BottomMarginText}" VerticalOptions="Center" />
                <Button Text="{loc:T Defaults.Style.Lower}" Style="{StaticResource ButtonQuiet}" Command="{Binding BottomMarginLowerCommand}" />
                <Button Text="{loc:T Defaults.Style.Higher}" Style="{StaticResource ButtonQuiet}" Command="{Binding BottomMarginHigherCommand}" />
            </HorizontalStackLayout>

            <Button Text="{loc:T Defaults.Style.Reset}" Style="{StaticResource ButtonQuiet}" Command="{Binding ResetStyleCommand}" />

            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   TextColor="{DynamicResource ColorDanger}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

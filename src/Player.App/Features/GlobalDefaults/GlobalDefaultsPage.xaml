<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Player.App.Features.DefaultsSettings.GlobalDefaultsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:defaults="clr-namespace:Player.App.Features.DefaultsSettings"
             xmlns:loc="clr-namespace:Player.App.Localization"
             x:DataType="defaults:GlobalDefaultsViewModel"
             Title="{loc:T Defaults.Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <Label Text="{loc:T Defaults.Playback}" Style="{StaticResource LabelSection}" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{loc:T Defaults.Speed}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding SpeedText}" VerticalOptions="Center" />
            </Grid>
            <Slider Minimum="0.25" Maximum="4.0" Value="{Binding Speed, Mode=TwoWay}"
                    DragCompletedCommand="{Binding SaveSpeedCommand}" />
            <Button Text="{loc:T Defaults.ResetSpeed}" Style="{StaticResource ButtonQuiet}" Command="{Binding ResetSpeedCommand}" />

            <Label Text="{loc:T Defaults.Decoder}" />
            <RadioButton Content="{loc:T Defaults.Decoder.Hardware}" GroupName="Decoder"
                         IsChecked="{Binding IsDecoderHardware, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Defaults.Decoder.Software}" GroupName="Decoder"
                         IsChecked="{Binding IsDecoderSoftware, Mode=TwoWay}" />

            <Label Text="{loc:T Defaults.Aspect}" />
            <RadioButton Content="{loc:T Defaults.Aspect.Fit}" GroupName="Aspect"
                         IsChecked="{Binding IsAspectFit, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Defaults.Aspect.Stretch}" GroupName="Aspect"
                         IsChecked="{Binding IsAspectStretch, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Defaults.Aspect.Crop}" GroupName="Aspect"
                         IsChecked="{Binding IsAspectCrop, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Defaults.Aspect.Original}" GroupName="Aspect"
                         IsChecked="{Binding IsAspectOriginal, Mode=TwoWay}" />

            <Label Text="{loc:T Defaults.Repeat}" />
            <RadioButton Content="{loc:T Common.Off}" GroupName="Repeat"
                         IsChecked="{Binding IsRepeatNone, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Defaults.Repeat.File}" GroupName="Repeat"
                         IsChecked="{Binding IsRepeatFile, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Defaults.Repeat.Folder}" GroupName="Repeat"
                         IsChecked="{Binding IsRepeatFolder, Mode=TwoWay}" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{loc:T Defaults.ResumeFromLastPosition}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ResumeFromLastPosition, Mode=TwoWay}" />
            </Grid>

            <Label Text="{loc:T Defaults.Background}" Style="{StaticResource LabelSection}" />

            <Label Text="{loc:T Defaults.LeaveChoice}" />
            <RadioButton Content="{loc:T Defaults.LeaveChoice.Window}" GroupName="LeaveChoice"
                         IsChecked="{Binding IsLeaveWindow, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Defaults.LeaveChoice.Sound}" GroupName="LeaveChoice"
                         IsChecked="{Binding IsLeaveSound, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Defaults.LeaveChoice.Pause}" GroupName="LeaveChoice"
                         IsChecked="{Binding IsLeavePause, Mode=TwoWay}" />
            <Label Text="{loc:T Defaults.LeaveChoice.Hint}" Style="{StaticResource LabelMuted}" />

            <Label Text="{loc:T Defaults.Audio}" Style="{StaticResource LabelSection}" />

            <Label Text="{loc:T Defaults.PreferredAudioLanguage}" />
            <Entry Text="{Binding PreferredAudioLanguage, Mode=TwoWay}"
                   Placeholder="{loc:T Defaults.LanguagePlaceholder}"
                   ReturnCommand="{Binding SaveLanguagesCommand}"
                   Unfocused="OnLanguageUnfocused" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{loc:T Defaults.AudioDelay}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding AudioDelayText}" VerticalOptions="Center" />
            </Grid>
            <HorizontalStackLayout Spacing="8">
                <Button Text="-50 ms" Style="{StaticResource ButtonQuiet}" Command="{Binding AudioDelayDownCommand}" />
                <Button Text="+50 ms" Style="{StaticResource ButtonQuiet}" Command="{Binding AudioDelayUpCommand}" />
                <Button Text="{loc:T Common.Reset}" Style="{StaticResource ButtonQuiet}" Command="{Binding AudioDelayResetCommand}" />
            </HorizontalStackLayout>

            <Label Text="{loc:T Defaults.Subtitles}" Style="{StaticResource LabelSection}" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{loc:T Defaults.ShowSubtitles}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding SubtitlesEnabled, Mode=TwoWay}" />
            </Grid>

            <Label Text="{loc:T Defaults.PreferredSubtitleLanguage}" />
            <Entry Text="{Binding PreferredSubtitleLanguage, Mode=TwoWay}"
                   Placeholder="{loc:T Defaults.LanguagePlaceholder}"
                   ReturnCommand="{Binding SaveLanguagesCommand}"
                   Unfocused="OnLanguageUnfocused" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{loc:T Defaults.SubtitleDelay}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding SubtitleDelayText}" VerticalOptions="Center" />
            </Grid>
            <HorizontalStackLayout Spacing="8">
                <Button Text="-50 ms" Style="{StaticResource ButtonQuiet}" Command="{Binding SubtitleDelayDownCommand}" />
                <Button Text="+50 ms" Style="{StaticResource ButtonQuiet}" Command="{Binding SubtitleDelayUpCommand}" />
                <Button Text="{loc:T Common.Reset}" Style="{StaticResource ButtonQuiet}" Command="{Binding SubtitleDelayResetCommand}" />
            </HorizontalStackLayout>

            <Button Text="{loc:T Defaults.SubtitleStyle}" Style="{StaticResource ButtonQuiet}" Command="{Binding OpenSubtitleStyleCommand}" />

            <Button Text="{loc:T Defaults.ResetAll}" Style="{StaticResource ButtonQuiet}" Command="{Binding ResetAllCommand}" />

            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   TextColor="{DynamicResource ColorDanger}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

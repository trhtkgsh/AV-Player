<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Player.App.Features.PlayerHud.PlayerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:surface="clr-namespace:Player.App.Surface"
    xmlns:vm="clr-namespace:Player.App.Features.PlayerHud"
    xmlns:controls="clr-namespace:Player.App.Features.PlayerHud.Controls"
    xmlns:loc="clr-namespace:Player.App.Localization"
    x:DataType="vm:PlayerViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{DynamicResource ColorBackground}">

    <Grid>
        <!-- (a) The picture, behind everything. -->
        <surface:VideoSurfaceView HorizontalOptions="Fill" VerticalOptions="Fill" />

        <!-- (b) Transparent tap layer: a single tap toggles the HUD. -->
        <ContentView BackgroundColor="Transparent">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleHudCommand}" />
            </ContentView.GestureRecognizers>
        </ContentView>

        <!-- (c) Loading indicator while the file opens. -->
        <ActivityIndicator
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsRunning="{Binding IsOpening}" />

        <!-- (d) HUD. Only the top and bottom bars have a background and catch input; the middle lets taps through. -->
        <Grid IsVisible="{Binding IsHudVisible}" RowDefinitions="Auto,*,Auto">

            <Grid
                Grid.Row="0"
                Padding="8,6"
                ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                ColumnSpacing="8"
                BackgroundColor="{DynamicResource ColorHudBackground}">
                <controls:HudIconButton
                    Grid.Column="0"
                    IconData="M15.5 4 L7.5 12 L15.5 20 L17.2 18.3 L10.9 12 L17.2 5.7 Z"
                    IconSize="24"
                    MirrorInRightToLeft="True"
                    IconColor="{DynamicResource ColorHudOnBackground}"
                    Command="{Binding CloseCommand}"
                    SemanticProperties.Description="{loc:T Common.Back}" />
                <Label
                    Grid.Column="1"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation"
                    Text="{Binding Title}"
                    TextColor="{DynamicResource ColorHudOnBackground}" />
                <controls:HudIconButton
                    Grid.Column="2"
                    IconData="F0 M4 5 H20 A2 2 0 0 1 22 7 V17 A2 2 0 0 1 20 19 H4 A2 2 0 0 1 2 17 V7 A2 2 0 0 1 4 5 Z M5 10.5 H11 V12.5 H5 Z M13 10.5 H19 V12.5 H13 Z M5 14.5 H9 V16.5 H5 Z M11 14.5 H19 V16.5 H11 Z"
                    IconSize="22"
                    WidthRequest="44"
                    IconColor="{DynamicResource ColorHudOnBackground}"
                    Command="{Binding OpenSubtitlesCommand}"
                    SemanticProperties.Description="{loc:T Player.Subtitles}" />
                <controls:HudIconButton
                    Grid.Column="3"
                    IconData="M3 9 H7 L12 4.5 V19.5 L7 15 H3 Z M14.5 8 L15.9 6.6 A7.6 7.6 0 0 1 15.9 17.4 L14.5 16 A5.6 5.6 0 0 0 14.5 8 Z"
                    IconSize="22"
                    WidthRequest="44"
                    IconColor="{DynamicResource ColorHudOnBackground}"
                    Command="{Binding OpenAudioCommand}"
                    SemanticProperties.Description="{loc:T Player.Audio}" />
                <controls:HudIconButton
                    Grid.Column="4"
                    IconData="M6 6 H16 V3 L21 7.5 L16 12 V9 H8 V12 H6 Z M18 18 H8 V21 L3 16.5 L8 12 V15 H16 V12 H18 Z"
                    IconSize="22"
                    WidthRequest="44"
                    IconColor="{DynamicResource ColorHudOnBackground}"
                    Command="{Binding OpenRepeatCommand}"
                    SemanticProperties.Description="{loc:T Player.Repeat}" />
                <Label
                    Grid.Column="5"
                    VerticalOptions="Center"
                    IsVisible="{Binding ShowClock}"
                    Text="{Binding ClockText}"
                    TextColor="{DynamicResource ColorHudOnBackground}" />
            </Grid>

            <Grid
                Grid.Row="2"
                Padding="12,8"
                RowDefinitions="Auto,Auto"
                RowSpacing="6"
                FlowDirection="LeftToRight"
                BackgroundColor="{DynamicResource ColorHudBackground}">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label
                        Grid.Column="0"
                        VerticalOptions="Center"
                        Text="{Binding PositionText}"
                        TextColor="{DynamicResource ColorHudOnBackground}" />
                    <Slider
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Minimum="0"
                        Maximum="{Binding DurationMs}"
                        Value="{Binding PositionMs, Mode=TwoWay}"
                        DragStartedCommand="{Binding SeekStartedCommand}"
                        DragCompletedCommand="{Binding SeekCompletedCommand}" />
                    <Label
                        Grid.Column="2"
                        VerticalOptions="Center"
                        Text="{Binding DurationText}"
                        TextColor="{DynamicResource ColorHudOnBackground}" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,*" ColumnSpacing="20">
                    <Button
                        Grid.Column="0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Text="{Binding SpeedText}"
                        Command="{Binding OpenSpeedCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource ColorHudOnBackground}"
                        BorderColor="{DynamicResource ColorHudOnBackground}"
                        BorderWidth="1"
                        CornerRadius="6"
                        FontSize="13"
                        Padding="10,4"
                        MinimumHeightRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="52"
                        SemanticProperties.Hint="{loc:T Player.PlaybackSpeed}" />
                    <controls:HudIconButton
                        Grid.Column="1"
                        IconData="M6 5 H8.5 V19 H6 Z M19 5 V19 L9.5 12 Z"
                        IconSize="26"
                        WidthRequest="56"
                        IconColor="{DynamicResource ColorHudOnBackground}"
                        Command="{Binding PreviousCommand}"
                        SemanticProperties.Description="{loc:T Player.Previous}" />
                    <controls:HudIconButton
                        Grid.Column="2"
                        IconData="M7 4.5 L19.5 12 L7 19.5 Z"
                        IconSize="36"
                        WidthRequest="64"
                        IsVisible="{Binding ShowPlayIcon}"
                        IconColor="{DynamicResource ColorHudOnBackground}"
                        Command="{Binding PlayPauseCommand}"
                        SemanticProperties.Description="{loc:T Player.Play}" />
                    <controls:HudIconButton
                        Grid.Column="2"
                        IconData="M6.5 5 H10.5 V19 H6.5 Z M13.5 5 H17.5 V19 H13.5 Z"
                        IconSize="36"
                        WidthRequest="64"
                        IsVisible="{Binding IsPlaying}"
                        IconColor="{DynamicResource ColorHudOnBackground}"
                        Command="{Binding PlayPauseCommand}"
                        SemanticProperties.Description="{loc:T Player.Pause}" />
                    <controls:HudIconButton
                        Grid.Column="3"
                        IconData="M15.5 5 H18 V19 H15.5 Z M5 5 L14.5 12 L5 19 Z"
                        IconSize="26"
                        WidthRequest="56"
                        IconColor="{DynamicResource ColorHudOnBackground}"
                        Command="{Binding NextCommand}"
                        SemanticProperties.Description="{loc:T Player.Next}" />
                    <Button
                        Grid.Column="4"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Text="{Binding DecoderText}"
                        Command="{Binding ToggleDecoderCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource ColorHudOnBackground}"
                        BorderColor="{DynamicResource ColorHudOnBackground}"
                        BorderWidth="1"
                        CornerRadius="6"
                        FontSize="13"
                        Padding="10,4"
                        MinimumHeightRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="52"
                        SemanticProperties.Hint="{loc:T Player.Decoder}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>

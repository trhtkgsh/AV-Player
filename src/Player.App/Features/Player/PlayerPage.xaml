<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Player.App.Features.PlayerHud.PlayerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:surface="clr-namespace:Player.App.Surface"
    xmlns:vm="clr-namespace:Player.App.Features.PlayerHud"
    xmlns:controls="clr-namespace:Player.App.Features.PlayerHud.Controls"
    xmlns:loc="clr-namespace:Player.App.Localization"
    xmlns:gestures="clr-namespace:Player.App.Gestures"
    x:DataType="vm:PlayerViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    SafeAreaEdges="None"
    BackgroundColor="{DynamicResource ColorBackground}">

    <Grid SafeAreaEdges="None">
        <!-- (a) The picture, behind everything. -->
        <surface:VideoSurfaceView HorizontalOptions="Fill" VerticalOptions="Fill" />

        <!-- (b) Native gesture view: taps, double taps and drags, reported through IGestureSource. -->
        <gestures:GestureOverlayView HorizontalOptions="Fill" VerticalOptions="Fill" />

        <!-- (c) Loading indicator while the file opens. -->
        <ActivityIndicator
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsRunning="{Binding IsOpening}" />

        <!-- (c2) On-screen indicator of gesture values: centered, about a third from the top, never catches input. -->
        <Border
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="{Binding OsdMargin}"
            Padding="16,8"
            InputTransparent="True"
            IsVisible="{Binding Osd.IsVisible}"
            BackgroundColor="{DynamicResource ColorHudBackground}"
            Stroke="Transparent"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 12">
            <Label
                FlowDirection="LeftToRight"
                FontSize="20"
                HorizontalTextAlignment="Center"
                Text="{Binding Osd.Text}"
                TextColor="{DynamicResource ColorHudOnBackground}" />
        </Border>

        <!-- (c3) Unlock button while the screen is locked. A round background keeps it visible on a bright picture. -->
        <Border
            HorizontalOptions="Start"
            VerticalOptions="Center"
            Margin="{Binding UnlockMargin}"
            WidthRequest="56"
            HeightRequest="56"
            IsVisible="{Binding IsUnlockVisible}"
            BackgroundColor="{DynamicResource ColorHudBackground}"
            Stroke="Transparent"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 28">
            <controls:HudIconButton
                IconData="F0 M6 10 H18 V21 H6 Z M11 14 H13 V17 H11 Z M8 10 V6 A4 4 0 0 1 16 6 H14 A2 2 0 0 0 10 6 V10 Z"
                IconSize="30"
                WidthRequest="56"
                HeightRequest="56"
                IconColor="{DynamicResource ColorHudOnBackground}"
                Command="{Binding UnlockCommand}"
                SemanticProperties.Description="{loc:T Player.Unlock}" />
        </Border>

        <!-- (d) HUD. Only the top and bottom bars have a background and catch input; the middle lets taps through. -->
        <Grid
            IsVisible="{Binding IsHudVisible}"
            InputTransparent="True"
            CascadeInputTransparent="False"
            RowDefinitions="Auto,*,Auto">

            <Grid
                Grid.Row="0"
                Padding="{Binding TopBarPadding}"
                RowDefinitions="Auto,Auto"
                BackgroundColor="{DynamicResource ColorHudBackground}">
                <Label
                    Grid.Row="0"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="{Binding Title}"
                    TextColor="{DynamicResource ColorHudOnBackground}" />
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                    ColumnSpacing="4">
                    <Label
                        Grid.Column="0"
                        VerticalOptions="Center"
                        IsVisible="{Binding ShowStatus}"
                        Text="{Binding StatusText}"
                        FontSize="11"
                        Opacity="0.8"
                        TextColor="{DynamicResource ColorHudOnBackground}" />
                    <Button
                        Grid.Column="1"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Text="{Binding SpeedText}"
                        Command="{Binding OpenSpeedCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource ColorHudOnBackground}"
                        BorderColor="{DynamicResource ColorHudOnBackground}"
                        BorderWidth="1"
                        CornerRadius="6"
                        FontSize="13"
                        Padding="10,4"
                        MinimumHeightRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="52"
                        SemanticProperties.Hint="{loc:T Player.PlaybackSpeed}" />
                    <controls:HudIconButton
                        Grid.Column="2"
                        IconData="F0 M3 5 H21 V19 H3 Z M5 7 V17 H19 V7 Z M7 9 H11 V10.5 H8.5 V13 H7 Z M17 15 H13 V13.5 H15.5 V11 H17 Z"
                        IconSize="22"
                        WidthRequest="40"
                        IconColor="{DynamicResource ColorHudOnBackground}"
                        Command="{Binding CycleAspectCommand}"
                        SemanticProperties.Description="{loc:T Player.Aspect}" />
                    <controls:HudIconButton
                        Grid.Column="3"
                        IconData="M10.5 4 H13.5 V7 H10.5 Z M10.5 10.5 H13.5 V13.5 H10.5 Z M10.5 17 H13.5 V20 H10.5 Z"
                        IconSize="22"
                        WidthRequest="40"
                        IconColor="{DynamicResource ColorHudOnBackground}"
                        Command="{Binding OpenMenuCommand}"
                        SemanticProperties.Description="{loc:T Player.Menu}" />
                    <controls:HudIconButton
                        Grid.Column="4"
                        IconData="F0 M6 10 H18 V21 H6 Z M11 14 H13 V17 H11 Z M8 10 V7 A4 4 0 0 1 16 7 V10 H14 V7 A2 2 0 0 0 10 7 V10 Z"
                        IconSize="22"
                        WidthRequest="40"
                        IconColor="{DynamicResource ColorHudOnBackground}"
                        Command="{Binding LockCommand}"
                        SemanticProperties.Description="{loc:T Player.Lock}" />
                </Grid>
            </Grid>

            <Grid
                Grid.Row="2"
                Padding="{Binding BottomBarPadding}"
                RowDefinitions="Auto,Auto"
                RowSpacing="6"
                FlowDirection="LeftToRight"
                BackgroundColor="{DynamicResource ColorHudBackground}">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label
                        Grid.Column="0"
                        VerticalOptions="Center"
                        Text="{Binding PositionText}"
                        TextColor="{DynamicResource ColorHudOnBackground}" />
                    <Slider
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Minimum="0"
                        Maximum="{Binding DurationMs}"
                        Value="{Binding PositionMs, Mode=TwoWay}"
                        DragStartedCommand="{Binding SeekStartedCommand}"
                        DragCompletedCommand="{Binding SeekCompletedCommand}" />
                    <Label
                        Grid.Column="2"
                        VerticalOptions="Center"
                        Text="{Binding DurationText}"
                        TextColor="{DynamicResource ColorHudOnBackground}" />
                </Grid>

                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="20"
                    HorizontalOptions="Center">
                    <controls:HudIconButton
                        Grid.Column="0"
                        IconData="M6 5 H8.5 V19 H6 Z M19 5 V19 L9.5 12 Z"
                        IconSize="26"
                        WidthRequest="56"
                        IconColor="{DynamicResource ColorHudOnBackground}"
                        Command="{Binding PreviousCommand}"
                        SemanticProperties.Description="{loc:T Player.Previous}" />
                    <controls:HudIconButton
                        Grid.Column="1"
                        IconData="M7 4.5 L19.5 12 L7 19.5 Z"
                        IconSize="36"
                        WidthRequest="64"
                        IsVisible="{Binding ShowPlayIcon}"
                        IconColor="{DynamicResource ColorHudOnBackground}"
                        Command="{Binding PlayPauseCommand}"
                        SemanticProperties.Description="{loc:T Player.Play}" />
                    <controls:HudIconButton
                        Grid.Column="1"
                        IconData="M6.5 5 H10.5 V19 H6.5 Z M13.5 5 H17.5 V19 H13.5 Z"
                        IconSize="36"
                        WidthRequest="64"
                        IsVisible="{Binding IsPlaying}"
                        IconColor="{DynamicResource ColorHudOnBackground}"
                        Command="{Binding PlayPauseCommand}"
                        SemanticProperties.Description="{loc:T Player.Pause}" />
                    <controls:HudIconButton
                        Grid.Column="2"
                        IconData="M15.5 5 H18 V19 H15.5 Z M5 5 L14.5 12 L5 19 Z"
                        IconSize="26"
                        WidthRequest="56"
                        IconColor="{DynamicResource ColorHudOnBackground}"
                        Command="{Binding NextCommand}"
                        SemanticProperties.Description="{loc:T Player.Next}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Player.App.Features.Explorer.FoldersPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:explorer="clr-namespace:Player.App.Features.Explorer"
             xmlns:loc="clr-namespace:Player.App.Localization"
             x:DataType="explorer:FoldersViewModel"
             Title="{Binding Title, TargetNullValue='Ariel Player'}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{loc:T Explorer.View}" Command="{Binding ChooseViewCommand}" />
        <ToolbarItem Text="{loc:T Common.Settings}" Order="Secondary" Command="{Binding OpenSettingsCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Folders}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="explorer:FolderRow">
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenRowCommand, Source={RelativeSource AncestorType={x:Type explorer:FoldersViewModel}}, x:DataType=explorer:FoldersViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Text="★" IsVisible="{Binding Favorite}"
                                   TextColor="{DynamicResource ColorOnSurfaceMuted}" VerticalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource LabelTitle}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding CountText}" IsVisible="{Binding ShowCount}"
                                   Style="{StaticResource LabelMuted}" />
                            <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Text="{Binding NewText}"
                                   IsVisible="{Binding HasNew}" TextColor="{DynamicResource ColorAccent}"
                                   FontAttributes="Bold" VerticalOptions="Center" />
                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Text="⋮" IsVisible="{Binding HasOptions}"
                                    SemanticProperties.Description="{loc:T Explorer.FolderOptions}"
                                    Style="{StaticResource ButtonQuiet}" Padding="10,0" VerticalOptions="Center"
                                    Command="{Binding OpenOptionsCommand, Source={RelativeSource AncestorType={x:Type explorer:FoldersViewModel}}, x:DataType=explorer:FoldersViewModel}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator IsRunning="{Binding ShowBusy}" IsVisible="{Binding ShowBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center" />

        <Label Text="{loc:T Explorer.NoFolders}" IsVisible="{Binding ShowNoFolders}"
               HorizontalOptions="Center" VerticalOptions="Center" />

        <Label Text="{loc:T Explorer.NoFavorites}" IsVisible="{Binding ShowNoFavorites}"
               HorizontalTextAlignment="Center" HorizontalOptions="Fill" VerticalOptions="Center" Margin="24" />

        <VerticalStackLayout IsVisible="{Binding PermissionDenied}" Padding="24" Spacing="12"
                             HorizontalOptions="Fill" VerticalOptions="Center">
            <Label Text="{loc:T Explorer.PermissionNeeded}"
                   HorizontalTextAlignment="Center" />
            <Button Text="{loc:T Common.TryAgain}" Command="{Binding RetryPermissionCommand}" />
            <Button Text="{loc:T Explorer.OpenAppSettings}" Command="{Binding OpenAppSettingsCommand}" />
        </VerticalStackLayout>

        <Label Grid.Row="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
               TextColor="{DynamicResource ColorDanger}" Margin="16" />
    </Grid>

</ContentPage>

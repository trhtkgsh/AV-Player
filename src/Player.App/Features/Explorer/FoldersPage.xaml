<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Player.App.Features.Explorer.FoldersPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:explorer="clr-namespace:Player.App.Features.Explorer"
             xmlns:loc="clr-namespace:Player.App.Localization"
             x:DataType="explorer:FoldersViewModel"
             x:Name="Page"
             Title="{Binding Title, TargetNullValue='Ariel Player'}">

    <ContentPage.Resources>
        <ToolbarItem x:Key="LayoutItem" Text="{Binding LayoutText}" Command="{Binding ToggleLayoutCommand}" />
        <ToolbarItem x:Key="SettingsItem" Text="{loc:T Common.Settings}" Order="Secondary" Command="{Binding OpenSettingsCommand}" />
        <ToolbarItem x:Key="SelectAllItem" Text="{loc:T Explorer.SelectAll}" Command="{Binding SelectAllCommand}" />
        <ToolbarItem x:Key="DeleteItem" Text="{loc:T Explorer.Delete}" Command="{Binding DeleteSelectedCommand}" />

        <!-- The ⋮ button: no border, transparent, muted, with a touch area of 44 x 44. -->
        <Style x:Key="OptionsButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="TextColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinimumWidthRequest" Value="44" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>

        <!-- A view-mode button: one line, no border. The marked mode gets its color and line from the row. -->
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
            <Setter Property="TextColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineBreakMode" Value="NoWrap" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>

        <DataTemplate x:Key="ListItem" x:DataType="explorer:FolderRow">

            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding OpenRowCommand, Source={RelativeSource AncestorType={x:Type explorer:FoldersViewModel}}, x:DataType=explorer:FoldersViewModel}"
                        CommandParameter="{Binding .}" />
                </Grid.GestureRecognizers>

            <Grid.Behaviors>
                    <explorer:LongPressBehavior
                        Command="{Binding BeginSelectCommand, Source={x:Reference Page}, x:DataType=explorer:FoldersViewModel}"
                        CommandParameter="{Binding .}" />
                </Grid.Behaviors>

                <BoxView Grid.ColumnSpan="4" Color="{DynamicResource ColorAccent}" Opacity="0.2"
                         InputTransparent="True" IsVisible="{Binding Selected}" />
                <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Text="★" IsVisible="{Binding Favorite}"
                       TextColor="{DynamicResource ColorOnSurfaceMuted}" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource LabelTitle}"
                       FontSize="{Binding NameFontSize, Source={RelativeSource AncestorType={x:Type explorer:FoldersViewModel}}, x:DataType=explorer:FoldersViewModel}" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding CountText}" IsVisible="{Binding ShowCount}"
                       Style="{StaticResource LabelMuted}" />
                <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Text="{Binding NewText}"
                       IsVisible="{Binding HasNew}" TextColor="{DynamicResource ColorAccent}"
                       FontAttributes="Bold" VerticalOptions="Center" />
                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" IsVisible="{Binding IsBrowsing, Source={RelativeSource AncestorType={x:Type explorer:FoldersViewModel}}, x:DataType=explorer:FoldersViewModel}">
                    <Button Text="⋮" IsVisible="{Binding HasOptions}"
                            SemanticProperties.Description="{loc:T Explorer.FolderOptions}"
                            Style="{StaticResource OptionsButton}" VerticalOptions="Center"
                            Command="{Binding OpenOptionsCommand, Source={RelativeSource AncestorType={x:Type explorer:FoldersViewModel}}, x:DataType=explorer:FoldersViewModel}"
                            CommandParameter="{Binding .}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GridItem" x:DataType="explorer:FolderRow">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" Padding="6">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding OpenRowCommand, Source={RelativeSource AncestorType={x:Type explorer:FoldersViewModel}}, x:DataType=explorer:FoldersViewModel}"
                        CommandParameter="{Binding .}" />
                </Grid.GestureRecognizers>
                <Grid.Behaviors>
                    <explorer:LongPressBehavior
                        Command="{Binding BeginSelectCommand, Source={x:Reference Page}, x:DataType=explorer:FoldersViewModel}"
                        CommandParameter="{Binding .}" />
                </Grid.Behaviors>

                <BoxView Grid.RowSpan="4" Color="{DynamicResource ColorAccent}" Opacity="0.2"
                         InputTransparent="True" IsVisible="{Binding Selected}" />
                <!-- The symbol and the ⋮ button share one cell: the button sits in the top-end corner of the symbol row. -->
                <Grid Grid.Row="0">
                    <Path Data="M3 6 H10 L12 8 H21 V19 H3 Z" Aspect="Uniform"
                          WidthRequest="{Binding FolderIconWidth, Source={RelativeSource AncestorType={x:Type explorer:FoldersViewModel}}, x:DataType=explorer:FoldersViewModel}"
                          HeightRequest="{Binding FolderIconHeight, Source={RelativeSource AncestorType={x:Type explorer:FoldersViewModel}}, x:DataType=explorer:FoldersViewModel}"
                          HorizontalOptions="Center" VerticalOptions="Center">
                        <Path.Fill>
                            <SolidColorBrush Color="{DynamicResource ColorOnSurfaceMuted}" />
                        </Path.Fill>
                    </Path>
                    <Grid HorizontalOptions="End" VerticalOptions="Start"
                          IsVisible="{Binding IsBrowsing, Source={RelativeSource AncestorType={x:Type explorer:FoldersViewModel}}, x:DataType=explorer:FoldersViewModel}">
                        <Button Text="⋮" IsVisible="{Binding HasOptions}"
                                SemanticProperties.Description="{loc:T Explorer.FolderOptions}"
                                Style="{StaticResource OptionsButton}"
                                Command="{Binding OpenOptionsCommand, Source={RelativeSource AncestorType={x:Type explorer:FoldersViewModel}}, x:DataType=explorer:FoldersViewModel}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </Grid>


                <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0" Text="★" IsVisible="{Binding Favorite}" TextColor="{DynamicResource ColorOnSurfaceMuted}" />
                    <Label Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource LabelTitle}"
                           MaxLines="2" LineBreakMode="TailTruncation"
                           FontSize="{Binding NameFontSize, Source={RelativeSource AncestorType={x:Type explorer:FoldersViewModel}}, x:DataType=explorer:FoldersViewModel}" />
                </Grid>
                <Label Grid.Row="2" Text="{Binding CountText}" IsVisible="{Binding ShowCount}" Style="{StaticResource LabelMuted}" />
                <Label Grid.Row="3" Text="{Binding NewText}" IsVisible="{Binding HasNew}"
                       TextColor="{DynamicResource ColorAccent}" FontAttributes="Bold" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- The view modes sit under the title bar and do not scroll with the list. Each mode button is one column. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,2" BackgroundColor="{DynamicResource ColorSurface}">
            <Button Grid.Row="0" Grid.Column="0" Text="{loc:T Explorer.ViewFolders}" Style="{StaticResource ModeButton}"
                    Command="{Binding SelectFoldersCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsFoldersMode, x:DataType=explorer:FoldersViewModel}" Value="True">
                        <Setter Property="TextColor" Value="{DynamicResource ColorAccent}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <BoxView Grid.Row="1" Grid.Column="0" HeightRequest="2" BackgroundColor="{DynamicResource ColorAccent}"
                     IsVisible="{Binding IsFoldersMode}" />

            <Button Grid.Row="0" Grid.Column="1" Text="{loc:T Explorer.ViewTree}" Style="{StaticResource ModeButton}"
                    Command="{Binding SelectBrowserCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsBrowserMode, x:DataType=explorer:FoldersViewModel}" Value="True">
                        <Setter Property="TextColor" Value="{DynamicResource ColorAccent}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <BoxView Grid.Row="1" Grid.Column="1" HeightRequest="2" BackgroundColor="{DynamicResource ColorAccent}"
                     IsVisible="{Binding IsBrowserMode}" />

            <Button Grid.Row="0" Grid.Column="2" Text="{loc:T Explorer.ViewFavorites}" Style="{StaticResource ModeButton}"
                    Command="{Binding SelectFavoritesCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsFavoritesMode, x:DataType=explorer:FoldersViewModel}" Value="True">
                        <Setter Property="TextColor" Value="{DynamicResource ColorAccent}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <BoxView Grid.Row="1" Grid.Column="2" HeightRequest="2" BackgroundColor="{DynamicResource ColorAccent}"
                     IsVisible="{Binding IsFavoritesMode}" />

            <Button Grid.Row="0" Grid.Column="3" Text="{loc:T Explorer.ViewFlat}" Style="{StaticResource ModeButton}"
                    Command="{Binding SelectAllFilesCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAllFilesMode, x:DataType=explorer:FoldersViewModel}" Value="True">
                        <Setter Property="TextColor" Value="{DynamicResource ColorAccent}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <BoxView Grid.Row="1" Grid.Column="3" HeightRequest="2" BackgroundColor="{DynamicResource ColorAccent}"
                     IsVisible="{Binding IsAllFilesMode}" />
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView x:Name="List" ItemsSource="{Binding Folders}" SelectionMode="None"
                            SizeChanged="OnListSizeChanged" />
        </RefreshView>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding ShowBusy}" IsVisible="{Binding ShowBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center" />

        <Label Grid.Row="1" Text="{loc:T Explorer.NoFolders}" IsVisible="{Binding ShowNoFolders}"
               HorizontalOptions="Center" VerticalOptions="Center" />

        <Label Grid.Row="1" Text="{loc:T Explorer.NoFavorites}" IsVisible="{Binding ShowNoFavorites}"
               HorizontalTextAlignment="Center" HorizontalOptions="Fill" VerticalOptions="Center" Margin="24" />

        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding PermissionDenied}" Padding="24" Spacing="12"
                             HorizontalOptions="Fill" VerticalOptions="Center">
            <Label Text="{loc:T Explorer.PermissionNeeded}"
                   HorizontalTextAlignment="Center" />
            <Button Text="{loc:T Common.TryAgain}" Command="{Binding RetryPermissionCommand}" />
            <Button Text="{loc:T Explorer.OpenAppSettings}" Command="{Binding OpenAppSettingsCommand}" />
        </VerticalStackLayout>

        <!-- A running batch covers the list. The tap gesture takes input so the list below gets none. -->
        <Grid Grid.Row="1" IsVisible="{Binding IsOperationRunning}" BackgroundColor="{DynamicResource ColorSurface}" Opacity="0.92"
              Padding="24">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer />
            </Grid.GestureRecognizers>
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsOperationRunning}" HorizontalOptions="Center" />
                <Label Text="{Binding OperationName}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <Label Grid.Row="2" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
               TextColor="{DynamicResource ColorDanger}" Margin="16" />
    </Grid>

</ContentPage>

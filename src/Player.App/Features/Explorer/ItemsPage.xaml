<?xml version="1.0" encoding="utf-8" ?>
    <ContentPage x:Name="Page"
                 x:Class="Player.App.Features.Explorer.ItemsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:explorer="clr-namespace:Player.App.Features.Explorer"
             xmlns:loc="clr-namespace:Player.App.Localization"
             x:DataType="explorer:ItemsViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <!-- The toolbar: the browse items and the selection items. The code-behind shows one set at a time. -->
        <ToolbarItem x:Key="SortItem" Text="{loc:T Explorer.Sort}" Command="{Binding ChooseSortCommand}" />
        <ToolbarItem x:Key="LayoutItem" Text="{Binding LayoutText}" Command="{Binding ToggleLayoutCommand}" />
        <ToolbarItem x:Key="SelectAllItem" Text="{loc:T Explorer.SelectAll}" Command="{Binding SelectAllCommand}" />
        <ToolbarItem x:Key="RenameItem" Text="{loc:T Explorer.Rename}" Command="{Binding RenameSelectedCommand}"
                     IsEnabled="{Binding CanRename}" />
        <ToolbarItem x:Key="MoveItem" Text="{loc:T Explorer.Move}" Command="{Binding MoveSelectedCommand}" />
        <ToolbarItem x:Key="CopyItem" Text="{loc:T Explorer.Copy}" Command="{Binding CopySelectedCommand}" />
        <ToolbarItem x:Key="DeleteItem" Text="{loc:T Explorer.Delete}" Command="{Binding DeleteSelectedCommand}" />

        <!-- The ⋮ button: no border, transparent, muted, with a touch area of 44 x 44 (as on the folder rows). -->
        <Style x:Key="OptionsButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="TextColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinimumWidthRequest" Value="44" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>

        <DataTemplate x:Key="ListItem" x:DataType="explorer:MediaRowViewModel">
            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto">
                <!-- The tap and the long press come from the behavior: a MAUI tap recognizer would block the long press. -->
                <Grid.Behaviors>
                    <explorer:LongPressBehavior
                        TapCommand="{Binding ViewModel.OpenCommand, Source={x:Reference Page}, x:DataType=explorer:ItemsPage}"
                        LongPressCommand="{Binding ViewModel.BeginSelectCommand, Source={x:Reference Page}, x:DataType=explorer:ItemsPage}"
                        CommandParameter="{Binding .}" />
                </Grid.Behaviors>

                <!-- The selected row is marked by a tint behind its content. -->
                <BoxView Grid.ColumnSpan="3" Color="{DynamicResource ColorAccent}" Opacity="0.2"
                         InputTransparent="True" IsVisible="{Binding IsSelected}" />

                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Image Source="{Binding ThumbnailPath}"
                           WidthRequest="{Binding ListThumbnailWidth, Source={RelativeSource AncestorType={x:Type explorer:ItemsViewModel}}, x:DataType=explorer:ItemsViewModel}"
                           HeightRequest="{Binding ListThumbnailHeight, Source={RelativeSource AncestorType={x:Type explorer:ItemsViewModel}}, x:DataType=explorer:ItemsViewModel}"
                           Aspect="AspectFill" BackgroundColor="{DynamicResource ColorSurface}" />
                    <ProgressBar Progress="{Binding Progress}" IsVisible="{Binding HasProgress}"
                                 WidthRequest="{Binding ListThumbnailWidth, Source={RelativeSource AncestorType={x:Type explorer:ItemsViewModel}}, x:DataType=explorer:ItemsViewModel}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding Name}" MaxLines="2" LineBreakMode="TailTruncation"
                           FontSize="{Binding NameFontSize}" />
                    <Label Text="{Binding InfoLine}" IsVisible="{Binding HasInfoLine}" Style="{StaticResource LabelMuted}" />
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{loc:T Explorer.NewTag}" IsVisible="{Binding IsNew}"
                               TextColor="{DynamicResource ColorAccent}" FontAttributes="Bold" />
                        <Label Text="{loc:T Explorer.Watched}" IsVisible="{Binding IsWatched}"
                               TextColor="{DynamicResource ColorWatched}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Button Grid.Column="2" Text="⋮" SemanticProperties.Description="{loc:T Explorer.FileOptions}"
                        Style="{StaticResource OptionsButton}" VerticalOptions="Center"
                        IsVisible="{Binding IsBrowsing, Source={RelativeSource AncestorType={x:Type explorer:ItemsViewModel}}, x:DataType=explorer:ItemsViewModel}"
                        Command="{Binding OpenOptionsCommand, Source={RelativeSource AncestorType={x:Type explorer:ItemsViewModel}}, x:DataType=explorer:ItemsViewModel}"
                        CommandParameter="{Binding .}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GridItem" x:DataType="explorer:MediaRowViewModel">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                <Grid.Behaviors>
                    <explorer:LongPressBehavior
                        TapCommand="{Binding ViewModel.OpenCommand, Source={x:Reference Page}, x:DataType=explorer:ItemsPage}"
                        LongPressCommand="{Binding ViewModel.BeginSelectCommand, Source={x:Reference Page}, x:DataType=explorer:ItemsPage}"
                        CommandParameter="{Binding .}" />
                </Grid.Behaviors>

                <BoxView Grid.RowSpan="5" Color="{DynamicResource ColorAccent}" Opacity="0.2"
                         InputTransparent="True" IsVisible="{Binding IsSelected}" />
                <Image Grid.Row="0" Source="{Binding ThumbnailPath}" HorizontalOptions="Fill"
                       HeightRequest="{Binding ThumbnailHeight}"
                       Aspect="AspectFill" BackgroundColor="{DynamicResource ColorSurface}" />
                <!-- The ⋮ button sits in the top-end corner of the thumbnail, as on the folder tiles. -->
                <Button Grid.Row="0" Text="⋮" HorizontalOptions="End" VerticalOptions="Start"
                        SemanticProperties.Description="{loc:T Explorer.FileOptions}"
                        Style="{StaticResource OptionsButton}"
                        IsVisible="{Binding IsBrowsing, Source={RelativeSource AncestorType={x:Type explorer:ItemsViewModel}}, x:DataType=explorer:ItemsViewModel}"
                        Command="{Binding OpenOptionsCommand, Source={RelativeSource AncestorType={x:Type explorer:ItemsViewModel}}, x:DataType=explorer:ItemsViewModel}"
                        CommandParameter="{Binding .}" />
                <ProgressBar Grid.Row="1" Progress="{Binding Progress}" IsVisible="{Binding HasProgress}" />
                <Label Grid.Row="2" Text="{Binding Name}" MaxLines="2" LineBreakMode="TailTruncation" Margin="6,0"
                       FontSize="{Binding NameFontSize}" />
                <Label Grid.Row="3" Text="{Binding InfoLine}" IsVisible="{Binding HasInfoLine}" Style="{StaticResource LabelMuted}" Margin="6,0" />
                <!-- The marks wrap to a second line rather than leave the tile at a large font scale. -->
                <FlexLayout Grid.Row="4" Wrap="Wrap" Margin="6,0">
                    <Label Text="{loc:T Explorer.NewTag}" IsVisible="{Binding IsNew}" Margin="0,0,8,0"
                           TextColor="{DynamicResource ColorAccent}" FontAttributes="Bold" />
                    <Label Text="{loc:T Explorer.Watched}" IsVisible="{Binding IsWatched}" Margin="0,0,8,0"
                           TextColor="{DynamicResource ColorWatched}" />
                </FlexLayout>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Entry Grid.Row="0" Placeholder="{loc:T Explorer.Search}" Text="{Binding SearchText, Mode=TwoWay}"
               ClearButtonVisibility="WhileEditing" />

        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView x:Name="List" ItemsSource="{Binding Rows}" SelectionMode="None"
                                Scrolled="OnListScrolled" SizeChanged="OnListSizeChanged" />
            </RefreshView>

            <ActivityIndicator IsRunning="{Binding ShowBusy}" IsVisible="{Binding ShowBusy}"
                               HorizontalOptions="Center" VerticalOptions="Center" />

            <!-- A running batch covers the list. The tap gesture takes input so the list below gets none. -->
            <Grid IsVisible="{Binding IsOperationRunning}" BackgroundColor="{DynamicResource ColorSurface}" Opacity="0.92"
                  RowDefinitions="*,Auto,*" Padding="24">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer />
                </Grid.GestureRecognizers>
                <VerticalStackLayout Grid.Row="1" Spacing="12" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsOperationRunning}" HorizontalOptions="Center" />
                    <Label Text="{Binding OperationName}" HorizontalTextAlignment="Center" />
                    <Button Text="{loc:T Common.Cancel}" Command="{Binding CancelOperationCommand}"
                            IsVisible="{Binding CanCancelOperation}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="{loc:T Explorer.NoFiles}" IsVisible="{Binding IsEmpty}"
                   HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding PermissionDenied}" Padding="24" Spacing="12"
                                 HorizontalOptions="Fill" VerticalOptions="Center">
                <Label Text="{loc:T Explorer.PermissionNeeded}"
                       HorizontalTextAlignment="Center" />
                <Button Text="{loc:T Common.TryAgain}" Command="{Binding RetryPermissionCommand}" />
                <Button Text="{loc:T Explorer.OpenAppSettings}" Command="{Binding OpenAppSettingsCommand}" />
            </VerticalStackLayout>

        </Grid>

        <Label Grid.Row="2" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
               TextColor="{DynamicResource ColorDanger}" Margin="16" />
    </Grid>

</ContentPage>

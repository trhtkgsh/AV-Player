<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Player.App.Features.Explorer.ItemsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:explorer="clr-namespace:Player.App.Features.Explorer"
             x:DataType="explorer:ItemsViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sort" Command="{Binding ChooseSortCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <Entry Grid.Row="0" Placeholder="Search" Text="{Binding SearchText, Mode=TwoWay}"
               ClearButtonVisibility="WhileEditing" />

        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView x:Name="List" ItemsSource="{Binding Rows}" SelectionMode="None"
                                Scrolled="OnListScrolled">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="explorer:MediaRowViewModel">
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type explorer:ItemsViewModel}}, x:DataType=explorer:ItemsViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Image Source="{Binding ThumbnailPath}" WidthRequest="96" HeightRequest="54"
                                           Aspect="AspectFill" BackgroundColor="{DynamicResource ColorSurface}" />
                                    <ProgressBar WidthRequest="96" Progress="{Binding Progress}"
                                                 IsVisible="{Binding HasProgress}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" MaxLines="2" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding InfoLine}" Style="{StaticResource LabelMuted}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="NEW" IsVisible="{Binding IsNew}"
                                               TextColor="{DynamicResource ColorAccent}" FontAttributes="Bold" />
                                        <Label Text="Watched" IsVisible="{Binding IsWatched}"
                                               TextColor="{DynamicResource ColorWatched}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center" VerticalOptions="Center" />

            <Label Text="No media files" IsVisible="{Binding IsEmpty}"
                   HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding PermissionDenied}" Padding="24" Spacing="12"
                                 HorizontalOptions="Fill" VerticalOptions="Center">
                <Label Text="Ariel Player needs permission to read your video and audio files."
                       HorizontalTextAlignment="Center" />
                <Button Text="Try again" Command="{Binding RetryPermissionCommand}" />
                <Button Text="Open app settings" Command="{Binding OpenAppSettingsCommand}" />
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource ColorDanger}"
                   Margin="16" VerticalOptions="End" />
        </Grid>
    </Grid>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Player.App.Features.InterfaceSettings.SettingsHomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Player.App.Features.InterfaceSettings"
             x:DataType="vm:SettingsHomeViewModel"
             Title="Settings">

    <VerticalStackLayout Padding="16" Spacing="8">

        <Grid Style="{StaticResource ListRow}" RowDefinitions="Auto,Auto">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenPlaybackDefaultsCommand}" />
            </Grid.GestureRecognizers>
            <Label Grid.Row="0" Text="Playback defaults" Style="{StaticResource LabelTitle}" />
            <Label Grid.Row="1" Text="Speed, decoder, repeat, audio and subtitles for new files"
                   Style="{StaticResource LabelMuted}" />
        </Grid>

        <Grid Style="{StaticResource ListRow}" RowDefinitions="Auto,Auto">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenInterfaceCommand}" />
            </Grid.GestureRecognizers>
            <Label Grid.Row="0" Text="Interface" Style="{StaticResource LabelTitle}" />
            <Label Grid.Row="1" Text="Player controls and file list" Style="{StaticResource LabelMuted}" />
        </Grid>

    </VerticalStackLayout>

</ContentPage>

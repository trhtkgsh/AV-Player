<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Player.App.Features.InterfaceSettings.SettingsHomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Player.App.Localization"
             xmlns:vm="clr-namespace:Player.App.Features.InterfaceSettings"
             x:DataType="vm:SettingsHomeViewModel"
             Title="{loc:T Common.Settings}">

    <VerticalStackLayout Padding="16" Spacing="8">

        <Grid Style="{StaticResource ListRow}" RowDefinitions="Auto,Auto">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenPlaybackDefaultsCommand}" />
            </Grid.GestureRecognizers>
            <Label Grid.Row="0" Text="{loc:T SettingsHome.PlaybackDefaults}" Style="{StaticResource LabelTitle}" />
            <Label Grid.Row="1" Text="{loc:T SettingsHome.PlaybackDefaultsHint}"
                   Style="{StaticResource LabelMuted}" />
        </Grid>

        <Grid Style="{StaticResource ListRow}" RowDefinitions="Auto,Auto">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenInterfaceCommand}" />
            </Grid.GestureRecognizers>
            <Label Grid.Row="0" Text="{loc:T SettingsHome.Interface}" Style="{StaticResource LabelTitle}" />
            <Label Grid.Row="1" Text="{loc:T SettingsHome.InterfaceHint}" Style="{StaticResource LabelMuted}" />
        </Grid>

        <Grid Style="{StaticResource ListRow}" RowDefinitions="Auto,Auto">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenThemeCommand}" />
            </Grid.GestureRecognizers>
            <Label Grid.Row="0" Text="{loc:T SettingsHome.Theme}" Style="{StaticResource LabelTitle}" />
            <Label Grid.Row="1" Text="{loc:T SettingsHome.ThemeHint}" Style="{StaticResource LabelMuted}" />
        </Grid>

    </VerticalStackLayout>

</ContentPage>

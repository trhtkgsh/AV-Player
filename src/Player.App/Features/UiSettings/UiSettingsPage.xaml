<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Player.App.Features.InterfaceSettings.UiSettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Player.App.Localization"
             xmlns:vm="clr-namespace:Player.App.Features.InterfaceSettings"
             x:DataType="vm:UiSettingsViewModel"
             Title="{loc:T Interface.Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <Label Text="{loc:T Interface.Language}" Style="{StaticResource LabelSection}" />

            <RadioButton Content="{loc:T Common.Language.System}" GroupName="Language"
                         IsChecked="{Binding IsLanguageSystem, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Common.Language.English}" GroupName="Language"
                         IsChecked="{Binding IsLanguageEnglish, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Common.Language.Hebrew}" GroupName="Language"
                         IsChecked="{Binding IsLanguageHebrew, Mode=TwoWay}" />

            <Label Text="{loc:T Interface.Player}" Style="{StaticResource LabelSection}" Margin="0,16,0,0" />

            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.HideControlsAfter}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding HudAutoHideText}" VerticalOptions="Center" />
            </Grid>
            <Slider Minimum="1" Maximum="10"
                    Value="{Binding HudAutoHideSeconds, Mode=TwoWay}"
                    DragCompletedCommand="{Binding SaveHudAutoHideCommand}" />

            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.SkipLength}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding SkipLengthText}" VerticalOptions="Center" />
            </Grid>
            <Slider Minimum="0" Maximum="4"
                    Value="{Binding SkipIndex, Mode=TwoWay}"
                    DragCompletedCommand="{Binding SaveSkipLengthCommand}" />

            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.LongPressSpeed}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding LongPressSpeedText}" VerticalOptions="Center" />
            </Grid>
            <Slider Minimum="0.25" Maximum="4"
                    Value="{Binding LongPressSpeed, Mode=TwoWay}"
                    DragCompletedCommand="{Binding SaveLongPressSpeedCommand}" />

            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.ShowClock}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ShowClock, Mode=TwoWay}" />
            </Grid>
            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.ShowBattery}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ShowBattery, Mode=TwoWay}" />
            </Grid>

            <Label Text="{loc:T Interface.Overlay.Title}" Style="{StaticResource LabelSection}" Margin="0,16,0,0" />

            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.Overlay.ProgressLine}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding OverlayProgressLine, Mode=TwoWay}" />
            </Grid>
            <Label Text="{loc:T Interface.Overlay.Edge}" />
            <RadioButton Content="{loc:T Interface.Overlay.Edge.Bottom}" GroupName="OverlayEdge"
                         IsChecked="{Binding IsEdgeBottom, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Edge.Top}" GroupName="OverlayEdge"
                         IsChecked="{Binding IsEdgeTop, Mode=TwoWay}" />

            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.Overlay.ProgressLineThickness}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding OverlayLineThicknessText}" VerticalOptions="Center" />
            </Grid>
            <Slider Minimum="1" Maximum="12"
                    Value="{Binding OverlayLineThickness, Mode=TwoWay}"
                    DragCompletedCommand="{Binding SaveOverlayLineThicknessCommand}" />

            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.Overlay.Clock}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding OverlayClock, Mode=TwoWay}" />
            </Grid>
            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.Overlay.Battery}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding OverlayBattery, Mode=TwoWay}" />
            </Grid>

            <Label Text="{loc:T Interface.Overlay.Time}" />
            <RadioButton Content="{loc:T Common.Off}" GroupName="OverlayTime"
                         IsChecked="{Binding IsTimeOff, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Time.Elapsed}" GroupName="OverlayTime"
                         IsChecked="{Binding IsTimeElapsed, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Time.ElapsedTotal}" GroupName="OverlayTime"
                         IsChecked="{Binding IsTimeElapsedTotal, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Time.Remaining}" GroupName="OverlayTime"
                         IsChecked="{Binding IsTimeRemaining, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Time.ElapsedRemaining}" GroupName="OverlayTime"
                         IsChecked="{Binding IsTimeElapsedRemaining, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Time.ElapsedTotalRemaining}" GroupName="OverlayTime"
                         IsChecked="{Binding IsTimeElapsedTotalRemaining, Mode=TwoWay}" />

            <Label Text="{loc:T Interface.Overlay.Corner}" />
            <RadioButton Content="{loc:T Interface.Overlay.Corner.TopLeft}" GroupName="OverlayCorner"
                         IsChecked="{Binding IsCornerTopLeft, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Corner.TopRight}" GroupName="OverlayCorner"
                         IsChecked="{Binding IsCornerTopRight, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Corner.BottomLeft}" GroupName="OverlayCorner"
                         IsChecked="{Binding IsCornerBottomLeft, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Corner.BottomRight}" GroupName="OverlayCorner"
                         IsChecked="{Binding IsCornerBottomRight, Mode=TwoWay}" />

            <Label Text="{loc:T Interface.Overlay.ClockCorner}" />
            <RadioButton Content="{loc:T Interface.Overlay.Corner.TopLeft}" GroupName="OverlayClockCorner"
                         IsChecked="{Binding IsClockCornerTopLeft, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Corner.TopRight}" GroupName="OverlayClockCorner"
                         IsChecked="{Binding IsClockCornerTopRight, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Corner.BottomLeft}" GroupName="OverlayClockCorner"
                         IsChecked="{Binding IsClockCornerBottomLeft, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Corner.BottomRight}" GroupName="OverlayClockCorner"
                         IsChecked="{Binding IsClockCornerBottomRight, Mode=TwoWay}" />

            <Label Text="{loc:T Interface.Overlay.BatteryCorner}" />
            <RadioButton Content="{loc:T Interface.Overlay.Corner.TopLeft}" GroupName="OverlayBatteryCorner"
                         IsChecked="{Binding IsBatteryCornerTopLeft, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Corner.TopRight}" GroupName="OverlayBatteryCorner"
                         IsChecked="{Binding IsBatteryCornerTopRight, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Corner.BottomLeft}" GroupName="OverlayBatteryCorner"
                         IsChecked="{Binding IsBatteryCornerBottomLeft, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Corner.BottomRight}" GroupName="OverlayBatteryCorner"
                         IsChecked="{Binding IsBatteryCornerBottomRight, Mode=TwoWay}" />

            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.Overlay.Margin}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding OverlayMarginText}" VerticalOptions="Center" />
            </Grid>
            <Slider Minimum="0" Maximum="48"
                    Value="{Binding OverlayMargin, Mode=TwoWay}"
                    DragCompletedCommand="{Binding SaveOverlayMarginCommand}" />

            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.Overlay.Size}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding OverlaySizeText}" VerticalOptions="Center" />
            </Grid>
            <Slider Minimum="10" Maximum="24"
                    Value="{Binding OverlaySize, Mode=TwoWay}"
                    DragCompletedCommand="{Binding SaveOverlaySizeCommand}" />

            <Label Text="{loc:T Interface.Overlay.Color}" />
            <RadioButton Content="{loc:T Interface.Overlay.Color.White}" GroupName="OverlayColor"
                         IsChecked="{Binding IsColorWhite, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Color.LightGray}" GroupName="OverlayColor"
                         IsChecked="{Binding IsColorLightGray, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Color.Yellow}" GroupName="OverlayColor"
                         IsChecked="{Binding IsColorYellow, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Color.Green}" GroupName="OverlayColor"
                         IsChecked="{Binding IsColorGreen, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Color.Cyan}" GroupName="OverlayColor"
                         IsChecked="{Binding IsColorCyan, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Color.Orange}" GroupName="OverlayColor"
                         IsChecked="{Binding IsColorOrange, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.Overlay.Color.Red}" GroupName="OverlayColor"
                         IsChecked="{Binding IsColorRed, Mode=TwoWay}" />

            <Label Text="{loc:T Interface.FileList}" Style="{StaticResource LabelSection}" Margin="0,16,0,0" />

            <Label Text="{loc:T Interface.ItemSize}" />
            <RadioButton Content="{loc:T Interface.ItemSize.Large}" GroupName="ItemSize"
                         IsChecked="{Binding IsItemSizeLarge, Mode=TwoWay}" />
            <RadioButton Content="{loc:T Interface.ItemSize.Small}" GroupName="ItemSize"
                         IsChecked="{Binding IsItemSizeSmall, Mode=TwoWay}" />

            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.NameSize}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding NameSizeText}" VerticalOptions="Center" />
            </Grid>
            <Slider Minimum="80" Maximum="160"
                    Value="{Binding NameSizePercent, Mode=TwoWay}"
                    DragCompletedCommand="{Binding SaveNameSizeCommand}" />

            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.ShowAudioOnlyFolders}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding IncludeAudioOnlyFolders, Mode=TwoWay}" />
            </Grid>

            <Label Text="{loc:T Interface.DetailsShown}" />
            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="Auto,*">
                <CheckBox Grid.Column="0" IsChecked="{Binding ShowDuration, Mode=TwoWay}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{loc:T Interface.Duration}" VerticalOptions="Center" />
            </Grid>
            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="Auto,*">
                <CheckBox Grid.Column="0" IsChecked="{Binding ShowResolution, Mode=TwoWay}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{loc:T Interface.Resolution}" VerticalOptions="Center" />
            </Grid>
            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="Auto,*">
                <CheckBox Grid.Column="0" IsChecked="{Binding ShowSize, Mode=TwoWay}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{loc:T Interface.Size}" VerticalOptions="Center" />
            </Grid>
            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="Auto,*">
                <CheckBox Grid.Column="0" IsChecked="{Binding ShowDate, Mode=TwoWay}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{loc:T Interface.Date}" VerticalOptions="Center" />
            </Grid>
            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="Auto,*">
                <CheckBox Grid.Column="0" IsChecked="{Binding ShowPath, Mode=TwoWay}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{loc:T Interface.FolderPath}" VerticalOptions="Center" />
            </Grid>

            <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T Interface.MarkNewFor}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding NewTagDaysText}" VerticalOptions="Center" />
            </Grid>
            <Slider Minimum="1" Maximum="30"
                    Value="{Binding NewTagDays, Mode=TwoWay}"
                    DragCompletedCommand="{Binding SaveNewTagDaysCommand}" />

            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   TextColor="{DynamicResource ColorDanger}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

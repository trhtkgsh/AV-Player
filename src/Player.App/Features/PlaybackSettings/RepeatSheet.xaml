<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Player.App.Features.PlaybackSettings.RepeatSheet"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Player.App.Features.PlaybackSettings"
    xmlns:loc="clr-namespace:Player.App.Localization"
    x:DataType="local:RepeatSheetViewModel"
    Shell.PresentationMode="ModalNotAnimated"
    Shell.NavBarIsVisible="False"
    BackgroundColor="Transparent">

    <Grid RowDefinitions="*,Auto">

        <!-- (a) The video stays visible here. A tap outside the panel closes the sheet. -->
        <ContentView Grid.Row="0" BackgroundColor="Transparent">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCommand}" />
            </ContentView.GestureRecognizers>
        </ContentView>

        <!-- (b) The translucent panel, on a dimmed backing so that bright video does not show through its text. -->
        <Grid Grid.Row="1">
            <BoxView
                Color="{DynamicResource ColorBackground}"
                Opacity="0.72"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />
            <VerticalStackLayout
            Padding="16,12,16,24"
            Spacing="12"
            BackgroundColor="{DynamicResource ColorHudBackground}">

            <Label Text="{loc:T Sheets.Repeat.Title}" Style="{StaticResource LabelHud}" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button
                    Grid.Column="0"
                    Text="{loc:T Common.Off}"
                    Command="{Binding SetRepeatNoneCommand}"
                    Style="{StaticResource ButtonHud}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsRepeatNone}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorAccent}" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorOnAccent}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button
                    Grid.Column="1"
                    Text="{loc:T Sheets.Repeat.ThisFile}"
                    Command="{Binding SetRepeatFileCommand}"
                    Style="{StaticResource ButtonHud}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsRepeatFile}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorAccent}" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorOnAccent}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button
                    Grid.Column="2"
                    Text="{loc:T Sheets.Repeat.Folder}"
                    Command="{Binding SetRepeatFolderCommand}"
                    Style="{StaticResource ButtonHud}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsRepeatFolder}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorAccent}" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorOnAccent}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <Label Text="{loc:T Sheets.Repeat.AbTitle}" Style="{StaticResource LabelHud}" />

            <Label Text="{Binding AbText}" Style="{StaticResource LabelHud}" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button
                    Grid.Column="0"
                    Text="{loc:T Sheets.Repeat.SetA}"
                    Command="{Binding SetACommand}"
                    Style="{StaticResource ButtonHud}" />
                <Button
                    Grid.Column="1"
                    Text="{loc:T Sheets.Repeat.SetB}"
                    Command="{Binding SetBCommand}"
                    IsEnabled="{Binding CanSetB}"
                    Style="{StaticResource ButtonHud}" />
                <Button
                    Grid.Column="2"
                    Text="{loc:T Sheets.Repeat.Clear}"
                    Command="{Binding ClearAbCommand}"
                    Style="{StaticResource ButtonHud}" />
            </Grid>

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{DynamicResource ColorDanger}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>

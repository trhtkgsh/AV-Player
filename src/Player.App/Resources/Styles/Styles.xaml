<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorBackground}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource ColorSurface}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource ColorOnSurface}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource ColorOnSurface}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource ColorSurface}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource ColorOnSurface}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource ColorOnSurface}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
        <Setter Property="Shell.TabBarDisabledColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
        <Setter Property="Shell.FlyoutBackgroundColor" Value="{DynamicResource ColorSurface}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorOnSurface}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="LabelMuted" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="LabelTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorOnSurface}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorAccent}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorOnAccent}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource ColorOnSurface}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource ColorAccent}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource ColorDivider}" />
        <Setter Property="ThumbColor" Value="{DynamicResource ColorAccent}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource ColorAccent}" />
        <Setter Property="ThumbColor" Value="{DynamicResource ColorOnSurface}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource ColorProgress}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource ColorProgress}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorBackground}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource ColorOnSurface}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource ColorProgress}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorDivider}" />
    </Style>

    <Style x:Key="ListRow" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="TextColor" Value="{DynamicResource ColorOnSurface}" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorOnSurface}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource ColorAccent}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource ColorOnSurface}" />
        <Setter Property="TitleColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource ColorOnSurface}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
    </Style>

    <Style x:Key="LabelSection" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorOnSurfaceMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,16,0,4" />
    </Style>

    <Style x:Key="SettingsRow" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="52" />
    </Style>

    <Style x:Key="ButtonQuiet" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource ColorOnSurface}" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorDivider}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="ButtonHud" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource ColorHudOnBackground}" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorHudOnBackground}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="LabelHud" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorHudOnBackground}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

</ResourceDictionary>

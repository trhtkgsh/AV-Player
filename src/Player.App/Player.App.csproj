<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>Player.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Ariel Player</ApplicationTitle>
		<ApplicationId>com.arielplayer.app</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

		<!-- LibVLC 3.6.5 native libraries are 4 KB aligned. See docs/SPIKE.md finding 9. -->
		<NoWarn>$(NoWarn);XA0141</NoWarn>
	</PropertyGroup>

	<!-- Release APK: 64-bit and 32-bit ARM phones, and x86_64 for the emulator. Never pass a RID on the command line (docs/ARCHITECTURE.md section 5). -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2F74E0" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#000000" BaseSize="128,128" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="LibVLCSharp" Version="3.10.2" />
		<PackageReference Include="VideoLAN.LibVLC.Android" Version="3.6.5" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Player.Core\Player.Core.csproj" />
		<ProjectReference Include="..\Player.Data\Player.Data.csproj" />
	</ItemGroup>

</Project>
